      },
      "accent": {
        "color": "#FDD60A",
        "usage": "Highlighted sponsor/event element"
      }
    },

    "gallery": {
      "theme": "Light",
      "background": "#FFFFFF",
      "background_word": {
        "scale": "Huge",
        "color": "#F2F2F2",
        "position": "Absolute behind gallery"
      },
      "composition": {
        "type": "Curved/arc-like editorial arrangement",
        "center_image": "Primary image",
        "side_images": "Smaller rotated images",
        "visual_flow": "Images form an orbit-like composition around a central focal point."
      },
      "rotation": {
        "side_images": "Approximately -10deg / +10deg",
        "center_image": "0deg"
      },
      "drag_indicator": {
