  "dark_mode": {
    "principle": "Dark mode is not simply light mode inverted. Use it primarily for immersive storytelling sections.",
    "background": "#000000",
    "text": "#FFFFFF",
    "muted_text": "#B5B5B5",
    "grid_lines": "rgba(255,255,255,0.12)",
    "accent": "#FDD60A",
    "images": {
      "default": "Prefer monochrome/high-contrast imagery",
      "overlay": "Use black overlays when text must remain readable",
      "color_images": "May remain in color when the image itself is an important focal element."
    },
    "section_transition": "Use deliberate transitions between light and dark sections rather than forcing the entire portfolio into one color mode."
  },

  "light_mode": {
    "principle": "Light sections should feel like printed editorial layouts.",
    "background": "#FFFFFF",
    "text": "#111111",
    "muted_text": "#737373",
    "grid_lines": "rgba(0,0,0,0.08)",
    "accent": "#FDD60A",
    "background_typography": "#F2F2F2",
    "images": "Use a mixture of monochrome and controlled-color project photography."
  },

  "imagery": {
    "style": [
      "High-contrast photography",
      "Black-and-white photography",
      "Action photography",
      "Portrait photography",
      "Project screenshots",
      "Product/project close-ups"
    ],
    "crop": "Prefer intentional crops rather than generic object-fit thumbnails.",
    "aspect_ratios": {
      "hero": "16:9 or full viewport",
      "editorial": "4:3",
      "portrait": "3:4",
      "square": "1:1"
    },
    "treatment": {
      "light_mode": "Natural or slightly desaturated",
      "dark_mode": "Black-and-white/high contrast when appropriate",
      "hover": "Subtle scale or tonal change"
    },
    "rule": "Photography should carry emotional weight. Avoid filling every empty area with images."
  },

  "motion": {
    "overall": "Slow, deliberate, editorial motion rather than flashy UI animation.",
    "recommended": [
      "Section reveal",
      "Typography stagger",
      "Image scale reveal",
      "Horizontal carousel movement",
      "Subtle image parallax",
      "Menu overlay reveal",
      "Smooth modal appearance",
      "Gallery drag motion"
    ],
    "easing": "Use smooth cubic-bezier easing with restrained duration.",
    "duration": {
      "micro": "150-250ms",
      "standard": "350-600ms",
      "editorial": "700-1200ms"
    },
    "rule": "Motion should reinforce storytelling and hierarchy. Never animate everything simultaneously."
  },

  "spacing": {
    "base_unit": "4px",
    "small": "8px",
    "medium": "16px",
    "large": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px",
    "4xl": "96px",
    "section_spacing": "120-240px desktop depending on section importance",
    "mobile_section_spacing": "72-120px",
    "rule": "Whitespace is one of the primary design elements."
  },

  "interaction_rules": {
    "hover": {
      "buttons": "Subtle translation, scale or color change",
      "links": "Underline, color shift or directional movement",
      "images": "Very subtle scale/contrast transition",
      "logos": "Opacity increase"
    },
    "focus": {
      "style": "Highly visible but visually compatible yellow focus indicator"
    },
    "accessibility": {
      "contrast": "Maintain strong contrast between text and background",
      "motion": "Respect reduced-motion preferences",
      "touch_targets": "Minimum approximately 44px where practical"
    }
  },

  "aksh_portfolio_adaptation": {
    "brand": "Akash",
    "content_direction": "Replace motorsport-specific storytelling with Akash's professional identity, frontend/full-stack development experience, selected projects, technical capabilities, career story and contact information.",
    "recommended_sections": [
      "Hero / Introduction",
      "Selected Work",
      "Professional Story",
      "Skills / Capabilities",
      "Featured Project Case Studies",
      "Experience / Career Timeline",
      "Personal Statement",
      "Contact",
      "Footer"
    ],
    "important": "The visual hierarchy should remain editorial and premium, but the content should clearly communicate Akash as a developer rather than imitating a racing driver's portfolio.",
    "portfolio_tone": [
      "Confident",
      "Technical",
      "Minimal",
      "Creative",
      "Professional",
      "Human",
      "Modern"
    ]
  },

  "developer_handoff_rules": {
    "must_preserve": [
      "Black/white editorial contrast",
      "Yellow accent",
      "Oversized typography",
      "Visible grid structure",
      "Large whitespace",
      "Sharp geometric controls",
      "Asymmetrical compositions",
      "Strong image treatment",
      "Light/dark section alternation",
      "Minimal navigation"
    ],
    "avoid": [
      "Generic SaaS dashboard styling",
      "Rounded card-heavy layouts",
      "Excessive gradients",
      "Pill-shaped buttons",
      "Excessive shadows",
      "Too many colors",
      "Dense card grids",
      "Conventional centered hero sections",
      "Unnecessary UI decoration",
      "Over-animated interactions"
    ]
  }
}