    "calendar": {
      "theme": "Dark",
      "background": "#000000",
      "layout": "Timeline/list",
      "rows": {
        "height": "Approximately 70-100px on desktop",
        "border_bottom": "1px subtle white/gray line",
        "left": "Event name",
        "middle": "Series/category",
        "right": "Date"
      },
      "center_visual": {
        "type": "Large vehicle/project image",
        "position": "Centered and vertically spanning multiple rows",
