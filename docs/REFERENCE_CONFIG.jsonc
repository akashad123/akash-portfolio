{
  "project": {
    "name": "Akash Portfolio — Motorsport Editorial Reference",
    "reference_style": "Nick Ho Motorsport portfolio",
    "design_direction": [
      "Editorial",
      "High-contrast",
      "Brutalist-inspired",
      "Premium sports/motorsport",
      "Minimal but visually aggressive",
      "Typography-led",
      "Image-led storytelling",
      "Strong grid system",
      "Large negative space",
      "Sharp geometric UI"
    ],
    "overall_character": {
      "description": "The reference is a highly art-directed personal portfolio rather than a conventional corporate portfolio. It relies on oversized typography, monochrome photography, strong black/white contrast, a small yellow accent, asymmetrical compositions, thin vertical grid lines, large whitespace, and full-screen storytelling sections.",
      "important_rule": "Do not reproduce the reference literally. Preserve its visual language and interaction philosophy while adapting the content, imagery, typography hierarchy, and identity to Akash's portfolio.",
      "visual_priority": [
        "Typography",
        "Photography/project imagery",
        "Whitespace",
        "Grid",
        "Motion/transition",
        "Yellow accent",
        "Navigation"
      ]
    }
  },

  "layout_system": {
    "base_viewport_reference": "1920x1080 desktop screenshot",
    "container_behavior": {
      "type": "fluid",
      "horizontal_padding_desktop": "approximately 5vw",
      "horizontal_padding_large_desktop": "approximately 4.5vw",
      "horizontal_padding_tablet": "approximately 5vw",
      "horizontal_padding_mobile": "20px to 24px",
      "max_width": "Avoid an overly restrictive centered max-width; the reference intentionally uses the full viewport."
    },

    "grid": {
      "desktop": {
        "columns": 12,
        "gutter": "0",
        "visual_dividers": "1px vertical rules between selected columns",
        "purpose": "The grid is visible as part of the visual identity rather than being purely structural."
      },
      "tablet": {
        "columns": 6
      },
      "mobile": {
        "columns": 4,
        "visual_dividers": "Use selectively; do not overcrowd small screens."
      }
    },

    "tailwind_breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px"
    },

    "responsive_behavior": {
      "mobile_0_639": {
        "layout": "Single-column editorial layout",
        "navigation": "Compact floating menu control",
        "typography": "Large but substantially reduced from desktop",
        "images": "Full-width or near-full-width",
        "grid": "Simplified",
        "horizontal_carousels": "Allow controlled horizontal overflow where appropriate",
        "decorative_elements": "Reduce non-essential decoration"
      },
      "sm_640_767": {
        "layout": "Single-column with occasional two-item arrangements",
        "spacing": "Increase section spacing moderately"
      },
      "md_768_1023": {
        "layout": "Tablet editorial grid",
        "columns": 6,
        "navigation": "Floating compact navigation",
        "hero": "Large typography remains dominant but wraps earlier"
      },
      "lg_1024_1279": {
        "layout": "Full editorial grid begins",
        "columns": 12,
        "large_text": "Strong display typography",
        "images": "Multi-column compositions"
      },
      "xl_1280_1535": {
        "layout": "Primary reference layout",
        "columns": 12,
        "spacing": "Generous",
        "typography": "Very large display typography"
      },
      "2xl_1536_plus": {
        "layout": "Expand horizontally without excessively increasing content width",
        "typography": "May scale using clamp() rather than fixed sizes",
        "spacing": "Maintain proportional whitespace"
      }
    }
  },

  "design_tokens": {
    "color_strategy": {
      "rule": "Use only two principal semantic palettes. Everything else should be grayscale or a controlled accent.",
      "primary": {
        "name": "Yellow",
        "base": "#FDD60A",
        "tailwind_similarity": "yellow-400 / yellow-500",
        "usage": [
          "Primary CTA buttons",
          "Navigation button",
          "Active states",
          "Highlighted words",
          "Important statistics",
          "Small decorative marks",
          "Progress indicators",
          "Interaction affordances"
        ]
      },
      "secondary": {
        "name": "Neutral Black",
        "base": "#000000",
        "tailwind_similarity": "black",
        "usage": [
          "Dark sections",
          "Primary dark background",
          "Primary text in light mode",
          "Large typographic backgrounds",
          "Overlay areas"
        ]
      },
      "grays": {
        "white": "#FFFFFF",
        "gray_50": "#FAFAFA",
        "gray_100": "#F2F2F2",
        "gray_200": "#E5E5E5",
        "gray_300": "#D4D4D4",
        "gray_400": "#A3A3A3",
        "gray_500": "#737373",
        "gray_600": "#525252",
        "gray_700": "#404040",
        "gray_800": "#262626",
        "gray_900": "#171717"
      },
      "accent_media": {
        "yellow_bright": "#FFE00A",
        "yellow_deep": "#F5C900",
        "overlay_black": "rgba(0,0,0,0.45)",
        "overlay_heavy": "rgba(0,0,0,0.70)",
        "light_grid": "rgba(0,0,0,0.08)",
        "dark_grid": "rgba(255,255,255,0.12)"
      }
    },

    "light_mode": {
      "background": "#FFFFFF",
      "surface": "#FFFFFF",
      "surface_muted": "#F2F2F2",
      "text_primary": "#111111",
      "text_secondary": "#737373",
      "text_muted": "#A3A3A3",
      "border": "rgba(0,0,0,0.08)",
      "grid": "rgba(0,0,0,0.08)",
      "accent": "#FDD60A"
    },

    "dark_mode": {
      "background": "#000000",
      "surface": "#0D0D0D",
      "surface_muted": "#171717",
      "text_primary": "#FFFFFF",
      "text_secondary": "#B5B5B5",
      "text_muted": "#737373",
      "border": "rgba(255,255,255,0.12)",
      "grid": "rgba(255,255,255,0.12)",
      "accent": "#FDD60A"
    }
  },

  "typography": {
    "style": "Condensed, heavy, uppercase display typography combined with clean neutral body typography.",
    "display": {
      "character": "Very bold, compressed, tall, athletic/editorial",
      "weight": "800-950",
      "case": "Mostly uppercase",
      "letter_spacing": "-0.04em to -0.07em",
      "line_height": "0.82 to 0.95",
      "usage": [
        "Hero headlines",
        "Section titles",
        "Large statistics",
        "Project titles",
        "Editorial statements"
      ]
    },
    "body": {
      "weight": "400-500",
      "line_height": "1.45-1.65",
      "letter_spacing": "normal",
      "usage": [
        "Descriptions",
        "Navigation",
        "Metadata",
        "Contact information"
      ]
    },
    "display_scale": {
      "mobile": "clamp(3rem, 14vw, 6rem)",
      "tablet": "clamp(4rem, 10vw, 8rem)",
      "desktop": "clamp(6rem, 9vw, 11rem)",
      "hero_max": "Approximately 10-12rem where appropriate"
    },
    "body_scale": {
      "small": "0.75rem-0.875rem",
      "regular": "0.9rem-1rem",
      "large": "1.1rem-1.35rem"
    },
    "typographic_rule": "Typography should feel like part of the composition, not simply content placed inside a conventional UI."
  },

  "global_ui": {
    "header": {
      "position": "Fixed or sticky depending on section behavior",
      "left": {
        "element": "Personal/logo mark",
        "size": "Small and visually restrained"
      },
      "right": {
        "element": "Yellow square menu trigger",
        "shape": "Square, sharp corners",
        "background": "#FDD60A",
        "icon": "Minimal dark menu/equal-line mark",
        "desktop_size": "Approximately 32-40px",
        "mobile_size": "Approximately 36-44px"
      },
      "background": "Transparent",
      "z_index": "Very high",
      "behavior": "Remain visually independent from the content underneath."
    },

    "buttons": {
      "shape": "Sharp rectangular geometry; no pill shapes",
      "background": "#FDD60A",
      "text": "#000000",
      "font": "Bold condensed uppercase",
      "padding": "Approximately 12px 18px",
      "icon": "Simple directional arrow or double-chevron",
      "hover": "Slight darkening, translation or scale; avoid excessive effects",
      "active": "Pressed/translated state",
      "border_radius": "0"
    },

    "navigation": {
      "default": "Collapsed navigation controlled by the square yellow menu button",
      "philosophy": "Navigation should not visually compete with the editorial content.",
      "menu_style": "Minimal, spacious, typographic",
      "links": "Large enough to interact with comfortably but visually restrained."
    },

    "dividers": {
      "style": "1px vertical or horizontal lines",
      "opacity": "Very subtle",
      "purpose": "Create an architectural editorial grid.",
      "rule": "Never use heavy borders."
    },

    "corners": {
      "default": "0px",
      "cards": "0px unless an image treatment specifically benefits from a subtle radius",
      "buttons": "0px",
      "inputs": "0px",
      "modal": "Small radius may be used only if needed for usability; reference is predominantly sharp-edged."
    }
  },

  "sections": {

    "media_articles": {
      "theme": "Light",
      "background": "#FFFFFF",
      "background_typography": {
        "content": "Large oversized word/letterform behind the section",
        "color": "#F2F2F2",
        "opacity": "Very subtle",
        "position": "Absolute",
        "pointer_events": false,
        "purpose": "Create depth without becoming readable content."
      },
      "heading": {
        "text_style": "Very heavy condensed uppercase",
        "size": "Large",
        "position": "Top-left",
        "margin_bottom": "Large"
      },
      "content": {
        "type": "Horizontal editorial media carousel",
        "desktop_visible_items": "Approximately 3-4 cards",
        "image_ratio": "Approximately 4:3",
        "image_fit": "cover",
        "gap": "16-24px",
        "overflow": "Horizontal",
        "card_text": {
          "font_size": "14-16px",
          "color": "#A0A0A0",
          "line_height": "1.35"
        }
      },
      "controls": {
        "position": "Upper-right / aligned with content",
        "buttons": "Minimal gray rectangular previous/next buttons",
        "hover": "Yellow accent or stronger contrast"
      }
    },

    "career_story_dark": {
      "theme": "Dark",
      "background": "#000000",
      "layout": "Three-part horizontal editorial composition",
      "left": {
        "heading": "Large white condensed uppercase title",
        "alignment": "Center vertically"
      },
      "center": {
        "image": "Portrait or stacked project/career imagery",
        "composition": "Image occupies a strong central visual anchor",
        "size": "Medium-large",
        "treatment": "Sharp rectangular frame"
      },
      "right": {
        "body_copy": "Small white/gray paragraph",
        "max_width": "Approximately 350-450px",
        "line_height": "1.5"
      },
      "cta": {
        "position": "Bottom-center",
        "style": "Yellow rectangular button"
      },
      "progress": {
        "position": "Bottom-right",
        "style": "Small yellow geometric mark + white numeric indicator",
        "example_pattern": "5/5"
      }
    },

    "sponsors_or_partners": {
      "theme": "Light",
      "background": "#FFFFFF",
      "layout": "Large architectural grid",
      "columns": "Approximately 5-7 vertical zones",
      "vertical_lines": true,
      "centerpiece": {
        "type": "Large central image/object",
        "position": "Centered",
        "scale": "Large",
        "surrounding_content": "Small logos or partner marks distributed vertically around it"
      },
      "logo_style": {
        "color": "Mostly black",
        "size": "Small to medium",
        "alignment": "Centered within each grid zone"
      },
      "interaction": "Logos can subtly change opacity or scale on hover."
    },

    "statement_section": {
      "theme": "Light",
      "background": "#FFFFFF",
      "layout": "Asymmetrical editorial composition",
      "center_content": {
        "type": "Large statement",
        "alignment": "Center",
        "max_width": "Approximately 700-900px",
        "font": "Extremely heavy condensed uppercase",
        "line_height": "Approximately 0.85-0.95"
      },
      "highlight": {
        "color": "#FDD60A",
        "rule": "Selected words/phrases receive yellow emphasis.",
        "amount": "Use selectively; approximately 15-30% of the statement."
      },
      "side_images": {
        "left": "Project/action image",
        "right": "Portrait/person image",
        "size": "Small-to-medium",
        "position": "Vertically centered",
        "fit": "cover"
      },
      "composition_rule": "The central typography must remain the dominant visual object."
    },

    "profile_stats": {
      "theme": "Dark",
      "background": "#000000",
      "background_media": {
        "type": "Large monochrome photography",
        "position": "Full section",
        "fit": "cover",
        "treatment": "High contrast black-and-white with dark overlay"
      },
      "grid": "Visible vertical grid lines",
      "layout": {
        "left": "Stats",
        "center": "Oversized primary number",
        "right": "Supporting statement and additional stats"
      },
      "stats": {
        "number": "Large bold white",
        "label": "Small white/gray",
        "spacing": "Generous vertical separation"
      },
      "main_number": {
        "scale": "Extremely large",
        "weight": "900+",
        "color": "#FFFFFF"
      },
      "profile_intro": {
        "name": "Large white condensed heading",
        "description": "Small body copy below",
        "position": "Bottom-left"
