      },
      "controls": {
        "position": "Bottom-center",
        "style": "Minimal rectangular previous/next controls"
      },
      "interaction": "Gallery should feel draggable/swipeable rather than like a conventional card grid."
    },

    "contact_modal": {
      "theme": "Dark backdrop + light form surface",
      "backdrop": {
        "background": "#000000",
        "opacity": "Very high",
